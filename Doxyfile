PROJECT_NAME           = bytebinder
PROJECT_BRIEF          = "Low-level memory manipulation and management library"
PROJECT_NUMBER         = 0.2.0

INPUT                  = include src
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARN_AS_ERROR          = NO

OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_OUTPUT            = html
USE_MDFILE_AS_MAINPAGE = README.md
INPUT                 += README.md

EXCLUDE                = deps build
EXCLUDE_PATTERNS       = */deps/* */build/*

ALPHABETICAL_INDEX     = YES
SHOW_INCLUDE_FILES     = YES
GENERATE_TODOLIST      = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
